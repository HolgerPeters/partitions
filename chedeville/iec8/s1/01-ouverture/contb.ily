\time 3/4
\figuremode {
  \override Staff.BassFigureAlignmentPositioning.direction = #UP
  \bassFigureExtendersOn

  \repeat volta 2 {
    s2.                   |
    s4 s s                |
    s4 s8 s s s           |
    s4 s s                |
    s <5/> s              |
    s8 s <6> q s4         |
    <5/> s s              |
    <_> q q               |
    s2.                   |
    s4 s s                |
    s4 <_>8 q q <5/>      |
    s4. s8 <6>4           |
    s4 <6/> s             |
    <_+>4. q8 <6>4        |
    <7 5>4 <_+> s         |
    s4 s s                |
    s2 s4                 |
    s4 s s s4 s8 s s <5/> |
    s4. s8 <6>4           |
    s4 s2                 |
    s4. s8 <6>4           |
    <6 5> <4> <3>         |
    s2 s4                 |
    s4 <_-> s             |
    <4 2> <6>8 q q s      |
    <7>4 <5/> s           |
    s s <6>               |
    <7> <5/> s            |
    \bassFigureExtendersOff
    s4. <6>8 <6>4         |
    <6 5>4 <4> s          |
    s2.                   |
  }
}

{
  \time 6/8 \key c \major
  \transpose c c'' {
    \repeat volta 2 {
      \partial 8 r8
      r4. r4 g,8             | % 1
      c b, c g,4 e8          | % 2
      d4 c8 b,4\battement c8 | % 3
      g,4. ~ g,4 r8          | % 4
      r4. r4 g,8             | % 5
      c8 b, c g,4 e8         | % 6
      d4 c8 b,4\battement c8 | % 7
      g,4. ~ g,4
    }
    \repeat volta 2 {
      e8                          | % \break
      e c d e f e                 | % 9
      e4.\tre ~ e4 b,8            | % 10
      c4 d8 e4 c8                 | % 11
      g,4. ~ g,4 b,8              | % 12
      b,8 g, a, b, c b,           | % 13
      b,4.\tre ~ b,4 g,8          | % 14
      c8 d c b,8\battement a,8 b, | % 15
      c4. ~ c4
    }
    \fine
  }
}

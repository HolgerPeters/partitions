{
  \time 6/8 \key c \major
  \transpose c c'' {
    \repeat volta 2 {
      \partial 8 g,8        | % 0
      c8 b, c g,4 c8        | % 1
      e8 d e c4 g8          | % 2
      f4 e8 d4\battement c8 | % 3
      d c d g,4 g,8         | % 4
      c8 b, c g,4 c8        | % 5
      e8 d e c4 g8          | % 6
      f4 e8 d4\battement c8 | % 7
      d4.( d4\tre)
    }
    \repeat volta 2 {
      g8               | % 8
      g8 e f g a g     | % 9
      g4. \tre ~ g4 d8 | % 10
      e4 d8 c4 e8      | % 11
      d4. g,4 d8       | % 12
      d8 b, c d e d    | % 13
      d4.\tre ~ d4 g8  | % 14
      e8 f e d e d     | % 15
      c4. ~ c4
    }
    \fine
  }
}

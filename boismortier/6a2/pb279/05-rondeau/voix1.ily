\transpose c c'' {
  \time 2/2 \key c \major
  \tempo "Modérément"
  \partial 4 g,4 | % 0
  \repeat volta 2 {
    c4 g, r4 c8 d           | % 1
    e4 c r e8 f             | % 2
    g4 a a g                | % 3
    g4 a a g                | % 4
    g4 c'8 b c' b a g       | % 5
    a8 g a g f e d c        | % 6
    g4 f8 e d4.\tre c8      | % \break
    c2\fermata r4 c4        | % 8
    d8 c b, a, g,4 c        | % 9
    d g, g, d               | % 10
    e4 f8 g b,4\battement c | % 11
    d2 r4 g4                | % 12
    g4 f8 e8 f4 f4          | % 13
    f4\tre e g f8 e         | % 14
    a8 b c' g a g f e       | % \break
    d2\tre r4 g,            | % 16
    c4 g, r4 c8 d           | % 17
    e4 c r e8 f             | % 18
    g4 a a g                | % 19
    g4 a a g                | % 20
    g4 c'8 b c' b a g       | % 21
    a8 g a g f e d c        | % 22
    g4 f8 e d4.\tre c8      | % \break
    c2 r4 e8 f              | % 24
    g4 c d e8 f             | % 25
    e4\tre d r4 e8 f        | % 26
    g4 c d e8 f             | % 27
    e2\tre r4 e8 f          | % 28
    g4 c8 b, a,4 d8 e       | % 29
    f4 b,8 a, g,4 c8 d      | % 30
    e4 a,8 g, f,4 d4        | % 31
    b,4.\tre a,8 g,4 g,     | % 32
  }
}

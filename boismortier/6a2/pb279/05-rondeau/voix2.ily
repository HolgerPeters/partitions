\transpose c c'' {
  \time 2/2 \key c \major
  \tempo "Modérément"
  \partial 4 r4 | % 0
  \repeat volta 2 {
    r4 e8 f g4 g,         | % 1
    r4 e8 f g4 c8 d       | % 2
    e4 f f e              | % 3
    e f f e               | % 4
    e c8 d e4 c           | % 5
    f8 e f e d c b, a,    | % 6
    g, e d c b,4.\tre c8  | % \break
    c4\fermata c8 d e4 c4 | % 8
    r4 g,8 a, b,4 a,4     | % 9
    g,4 b,8 c d4 b,4      | % 10
    c4 d8 e d4 c          | % 11
    b,4 g,8 a, b,4 g,     | % 12
    a,4 b,8 c b,4 g,      | % 13
    c2 e4 d8 c            | % 14
    f8 g e g f e d c      | % 15
    % break
    g,4 b,8 c d4 b,      | % 16
    r4 e8 f g4 g,        | % 17
    r4 e8 f g4 c8 d      | % 18
    e4 f f e             | % 19
    e f f e              | % 20
    e c8 d e4 c          | % 21
    f8 e f e d c b, a,   | % 22
    g, e d c b,4.\tre c8 | % \break
    c4 e8 f g4 c         | % 24
    b, a, b, g,          | % 25
    c4 g,8 a, b,4 c      | % 26
    b, a, b, g,          | % 27
    c4 e8 f g4 c         | % 28
    r4 e f r             | % 29
    r d e r              | % 30
    r c d r              | % 31
    r d8 c d4 b,         | % 32
  }
}

\transpose c c'' {
  \repeat volta 2 {
    \time 2/2 \key c \major
    \partial 2 g,4 g, | % 0
    a, g, g, a,8 b,   | % 1
    c4 g, c c         | % 2
    d f e d           | % 3
    c2
  }
  \repeat volta 2 {
    e4 e              | % 4
    e e e e           | % 5
    e\battement d e f | % 6
    g f8 e d4 c       | % 7
    g2 g,4 g,         | % 8
    a, g, g, a,8 b,   | % 9
    c4 g, c c         | % 10
    d f e d           | % 11
    c2 g4 g           | % 12
    e4 c g g          | % 13
    e2\tre g4 g4      | % 14
    a a f f           | % 15
    g2 c4 c           | % 16
    d4 c8 d e4 f8 e   | % 17
    d4 c8 d e4 f8 e   | % 18
    d4 c8 d e4 f8 e   | % 19
    d2\tre g,4 g,     | % 20
    a,4 g, g, a,8 b,  | % 21
    c4 g, c c         | % 22
    d4 f e d          | % 23
    c2
  }
}

\transpose c c'' {
  \time 2/2 \key c \major
  \repeat volta 2 {
    \partial 2 e4 g | % 0
    f4 e d c8 d     | % 1
    e4 c e g        | % 2
    b, d c b,       | % 3
    c2
  }
  \repeat volta 2 {
    c4 c               | % 4
    c c c c            | % 5
    c g, c d           | % 6
    e d8 c b,4 a,      | % 7
    g,2 e4 e           | % 8
    f e d c8 d         | % 9
    e4 c e g           | % 10
    b,4 d c b,         | % 11
    c2 r2              | % 12
    g4 g e c           | % 13
    g g e c            | % 14
    f f d d            | % 15
    e2 e4 d8 c         | % 16
    b,4 a,8 b, c4 d8 c | % 17
    b,4 a,8 b, c4 d8 c | % 18
    b,4 a,8 b, c4 d8 c | % 19
    b,4 g, e g         | % 20
    f e d c8 d         | % 21
    e4 c e g           | % 22
    b, d c b,          | % 23
    c2
  }
}
